# Admin UI login (defaults to admin/admin if unset)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Change in any non-local deploy
SESSION_SECRET=change-me-to-a-long-random-string

BIND=0.0.0.0:8080
DATA_DIR=./data
# DATABASE_PATH=./data/logdb.sqlite
# WEB_DIR=web/dist
# RUST_LOG=info

# URL Vector agents / MCP clients use to reach this app (LAN IP or reverse-proxy origin — not localhost if agents are remote)
PUBLIC_BASE_URL=http://localhost:8080

# Optional bootstrap API keys (created on startup if missing)
# BOOTSTRAP_INGEST_KEY=lk_your_ingest_key
# BOOTSTRAP_QUERY_KEY=lk_your_query_key

RETENTION_DAYS=14
# MAX_EVENTS=5000000

WRITE_QUEUE_CAPACITY=64
# MAX_BODY_BYTES=10485760
PER_KEY_RPS=50

# Optional OpenAI-compatible embeddings for semantic search (both BASE_URL + MODEL required)
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_API_KEY=sk-...
# EMBEDDING_DIM=1536
# EMBED_SAMPLE_RATE=0.02
