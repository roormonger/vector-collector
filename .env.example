# Admin UI login (defaults to admin/admin if unset)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Change in any non-local deploy
SESSION_SECRET=change-me-to-a-long-random-string

# Listen address — 0.0.0.0:8080 = all interfaces (Docker default); 127.0.0.1:8080 = this machine only
BIND=0.0.0.0:8080

# Optional: path to built admin UI (Docker image sets this). Local: web/dist after npm run build
# WEB_DIR=web/dist
# RUST_LOG=info

# First-boot defaults only (also editable in admin Settings after start). Existing SQLite values are kept.
PUBLIC_BASE_URL=http://localhost:8080

# Optional bootstrap API keys (created on startup if missing)
# BOOTSTRAP_INGEST_KEY=lk_your_ingest_key
# BOOTSTRAP_QUERY_KEY=lk_your_query_key

# Data always lives at /data (SQLite: /data/logdb.sqlite). Mount a volume there in Docker.
